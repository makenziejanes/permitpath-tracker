# Added automatically when you connect a Neon database in Vercel (Storage tab)
DATABASE_URL=

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional but recommended: a shared code you both enter once per device.
# Anyone can VIEW the dashboard (your instructor); only people with the code can change it.
TEAM_CODE=
